 "referrals": {
  "mianjia": "兩頰蝶形紅斑或日曬後起疹，可能與紅斑性狼瘡等自體免疫疾病有關，建議到過敏免疫風濕科檢查。",
  "kouyang": "反覆口腔潰瘍，若合併皮疹、眼睛紅痛、關節痛或生殖器潰瘍，須排除貝西氏症、狼瘡等，建議到過敏免疫風濕科檢查。",
  "tuofa": "短期內大量掉髮，若合併皮疹、口破、關節痛或發燒，須排除狼瘡等，建議到過敏免疫風濕科檢查。",
  "pijing": "皮膚逐漸變硬、緊繃，須排除硬皮症，建議到過敏免疫風濕科檢查。",
  "leinuo": "手指遇冷變白變紫（雷諾現象），可能與硬皮症、狼瘡等有關，建議到過敏免疫風濕科檢查。",
  "gankou": "口乾、眼乾都很明顯且持續，須排除乾燥症，建議到過敏免疫風濕科檢查。",
  "guanjie": "關節腫痛，尤其多處、對稱或超過六週，須排除類風濕性關節炎、乾癬性關節炎、狼瘡等，建議到過敏免疫風濕科檢查。",
  "chenjiang": "早上關節僵硬超過半小時，是發炎性關節炎的特徵，建議到過敏免疫風濕科檢查。",
  "yaobei": "下背痛在早上僵硬、活動後減輕，持續三個月以上，須排除僵直性脊椎炎，建議到過敏免疫風濕科檢查。",
  "jiwuli": "肌肉無力或眼皮紫紅疹，須排除皮肌炎、多發性肌炎，建議到過敏免疫風濕科檢查。",
  "fashao": "不明原因反覆發燒，須排除感染、自體免疫疾病與血液疾病，請就醫檢查（感染科或過敏免疫風濕科）。",
  "niaopao": "尿有泡泡或水腫合併皮疹、關節痛，須排除狼瘡腎炎，請盡快到過敏免疫風濕科或腎臟科檢查尿液與腎功能。",
  "xueshuan": "反覆流產或血栓，須排除抗磷脂症候群，建議到過敏免疫風濕科檢查。",
  "yiquezhen": "已確診的自體免疫疾病請持續在免疫科回診，不要自行停藥；中藥調理前先告知免疫科醫師。",
  "yaowu": "類固醇、免疫抑制劑或生物製劑不可自行停藥或減量；服用任何中藥前，請先告知免疫科醫師。",
  "d_lupus": "紅斑性狼瘡須由過敏免疫風濕科確診並長期追蹤（定期驗血、驗尿看腎臟），不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_ra": "類風濕性關節炎宜及早在過敏免疫風濕科治療，以免關節變形，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_pso": "乾癬（牛皮癬、銀屑病）由皮膚科診治；合併關節腫痛（乾癬性關節炎）或需要全身性用藥時，由過敏免疫風濕科一起追蹤，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_sjs": "乾燥症屬過敏免疫風濕科診治，眼乾、口乾也可請眼科、牙科協助照護，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_as": "僵直性脊椎炎屬過敏免疫風濕科診治，規則用藥並持續運動可減少脊椎僵硬，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_ssc": "硬皮症屬過敏免疫風濕科診治，須定期檢查肺、腎與心臟，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_dm": "皮肌炎、多發性肌炎屬過敏免疫風濕科診治，成人須另做癌症篩檢，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_bd": "貝西氏症屬過敏免疫風濕科診治；眼睛紅痛、視力模糊要盡快看眼科，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_vas": "血管炎屬過敏免疫風濕科診治，可能侵犯腎、肺、神經，須盡快檢查，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_gout": "痛風由過敏免疫風濕科或新陳代謝科診治；急性發作的紅腫熱痛要就醫，長期須控制尿酸，不可自行停藥；中藥只能在醫師知情下作輔助。",
  "d_zoster": "帶狀疱疹（皮蛇）是病毒感染，不屬免疫科：請盡快看皮膚科，發疹三天內用抗病毒藥效果最好；長在眼睛周圍、額頭或鼻尖要同時看眼科，以免傷眼。疹退後神經痛持續，可到疼痛科。"
 },
